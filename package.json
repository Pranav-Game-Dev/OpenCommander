{
  "name": "opencommander",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "typecheck": "tsc -p packages/shared && tsc -p packages/agent && tsc -p packages/gateway",
    "test": "vitest run",
    "build": "npm run typecheck && npm run build -w @opencommander/agent",
    "dev:gateway": "npm run dev -w @opencommander/gateway",
    "agent": "tsx --env-file-if-exists=.env packages/agent/src/cli.ts",
    "livelink": "tsx --env-file-if-exists=.env packages/agent/src/cli.ts livelink",
    "manage": "tsx --env-file-if-exists=.env packages/agent/src/manage.ts"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261028.1",
    "@types/node": "22.20.5",
    "@types/ws": "8.18.2",
    "esbuild": "0.28.2",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.5",
    "wrangler": "4.154.0"
  }
}
