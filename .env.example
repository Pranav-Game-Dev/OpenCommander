# Windows agent + admin CLI settings. Copy to .env (git-ignored) and fill in. Placeholders only -- no real secrets here.

# Your deployed gateway, https only (http://localhost:8787 is allowed for local development).
OC_GATEWAY_URL=https://dc-free-gateway.YOUR-SUBDOMAIN.workers.dev

# Folder(s) the agent may expose. Separate several with ';' on Windows. Whole drives (C:\) are refused.
OC_WORKSPACES=C:\Users\YOU\projects

# Friendly name shown in the device list.
OC_DEVICE_NAME=my-windows-pc

# Needed only for `admin` commands (create pairing codes, list/revoke devices). Same value as the gateway's ADMIN_TOKEN secret.
# Prefer setting it in the shell for one-off use instead of saving it on disk.
OC_ADMIN_TOKEN=

# Optional: override where the paired device token is stored (default: %APPDATA%\opencommander\device.json).
# OC_TOKEN_FILE=
# Optional: set OC_DEVICE_TOKEN instead of using the token file.
# OC_DEVICE_TOKEN=
